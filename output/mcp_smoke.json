{
  "server": "campus-customs",
  "config": ".mcp.json",
  "database": "data/campus_customs_new.db",
  "client": "Claude Code (desktop app), tools called over MCP stdio",
  "tested_on": "2026-10-12 (check_stock, get_lease) and 2026-10-13 (get_pricing)",
  "tests": [
    {
      "ticket": 101,
      "prompt": "Use the campus-customs MCP tool check_stock to see if we have CC-TEE-WHITE in size S for ticket 101 (need 1)",
      "tool": "check_stock",
      "mcp_tool_id": "mcp__campus-customs__check_stock",
      "arguments": {
        "sku": "CC-TEE-WHITE",
        "size": "S",
        "qty_needed": 1
      },
      "output": {
        "found": true,
        "sku": "CC-TEE-WHITE",
        "name": "Classic Bulldog Tee",
        "size": "S",
        "qty": 0,
        "location": "Aisle B",
        "in_stock": false,
        "qty_needed": 1,
        "can_fill": false,
        "shortage": 1
      },
      "db_check": {
        "query": "SELECT * FROM inventory WHERE sku='CC-TEE-WHITE' AND size='S';",
        "db_row": {
          "sku": "CC-TEE-WHITE",
          "name": "Classic Bulldog Tee",
          "size": "S",
          "qty": 0,
          "location": "Aisle B"
        },
        "matches": true
      }
    },
    {
      "ticket": 102,
      "prompt": "Use the campus-customs MCP tool get_lease to look up lease 1 for the rent notice in ticket 102",
      "tool": "get_lease",
      "mcp_tool_id": "mcp__campus-customs__get_lease",
      "arguments": {
        "lease_id": 1
      },
      "output": {
        "found": true,
        "id": 1,
        "space_name": "Chapel Street shop",
        "landlord": "Elm City Properties",
        "monthly_rent": 2400,
        "next_due": "2026-09-02",
        "notes": null,
        "shop_today": "2026-08-31",
        "days_until_due": 2,
        "overdue": false
      },
      "db_check": {
        "query": "SELECT * FROM leases WHERE id=1; SELECT date_today FROM desk;",
        "db_row": {
          "id": 1,
          "space_name": "Chapel Street shop",
          "landlord": "Elm City Properties",
          "monthly_rent": 2400.0,
          "next_due": "2026-09-02",
          "notes": null,
          "desk.date_today": "2026-08-31"
        },
        "matches": true
      }
    },
    {
      "ticket": 103,
      "prompt": "Use the campus-customs MCP tool get_pricing for CC-HOOD-NAVY with qty 20 for the bulk discount in ticket 103",
      "tool": "get_pricing",
      "mcp_tool_id": "mcp__campus-customs__get_pricing",
      "arguments": {
        "sku": "CC-HOOD-NAVY",
        "qty": 20
      },
      "output": {
        "found": true,
        "sku": "CC-HOOD-NAVY",
        "unit_cost": 22,
        "list_price": 58,
        "margin_per_unit": 36,
        "margin_pct": 62.1,
        "qty": 20,
        "total_at_list": 1160,
        "total_cost": 440
      },
      "db_check": {
        "query": "SELECT * FROM pricing WHERE sku='CC-HOOD-NAVY';",
        "db_row": {
          "sku": "CC-HOOD-NAVY",
          "unit_cost": 22.0,
          "list_price": 58.0
        },
        "derived_checks": {
          "margin_per_unit": "58 - 22 = 36",
          "margin_pct": "36 / 58 = 62.1%",
          "total_at_list": "20 x 58 = 1160",
          "total_cost": "20 x 22 = 440"
        },
        "matches": true
      }
    }
  ]
}